# --- Database (Postgres) ---
# Local dev: a Postgres URL (Docker / Postgres.app / homebrew).
# Production: use Neon's POOLED connection string (ends with `-pooler` host).
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
# Used by prisma migrate / db push at build time. On Neon this is the
# DIRECT (non-pooled) URL. Locally it can be the same as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# --- Stripe (test mode for dev, live mode for prod) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
REPORT_PRICE_CENTS=500

# --- App ---
# In production on Netlify, set this to https://<your-site>.netlify.app
APP_URL="http://localhost:3000"

# --- Admin ---
ADMIN_PASSWORD="change-me"
SESSION_SECRET="at-least-32-characters-of-random-junk-here-please-rotate"
